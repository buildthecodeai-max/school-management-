# Copy to .env and adjust for your environment.
DATABASE_URL="postgresql://sms:sms_dev_password@localhost:5433/sms?schema=public"
AUTH_SECRET="generate-a-long-random-string"
APP_NAME="Scholarum"
NODE_ENV="development"

# Required by the internal cron handlers (/api/internal/cron/*). Callers must
# send `Authorization: Bearer <CRON_SECRET>`. Without it those endpoints refuse
# every request, so set it in any environment where the schedulers run.
CRON_SECRET="generate-a-long-random-string"
