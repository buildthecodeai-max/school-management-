{
  "name": "school-management-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Commercial multi-tenant SaaS school management platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "docker compose up -d && prisma db push && tsx prisma/seed.ts",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:unit": "vitest run tests/unit",
    "test:all": "vitest run && vitest run --config vitest.integration.config.mts",
    "audit:verify": "tsx scripts/verify-audit-chains.ts",
    "audit:backfill": "tsx scripts/backfill-audit-chain.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^6.2.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.25",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
