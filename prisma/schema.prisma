// ---------------------------------------------------------------------------
// Operational finance ledger — cash/bank accounts, income, expenses and funds
// ---------------------------------------------------------------------------

enum FinancialAccountType {
  CASH
  BANK
  PETTY_CASH
  GATEWAY
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

model FinancialAccount {
  id             String               @id @default(cuid())
  tenantId       String
  campusId       String
  name           String
  code           String
  type           FinancialAccountType
  openingBalance Int                  @default(0)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  campus       Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId, campusId])
  @@map("financial_accounts")
}

model FinanceCategory {
  id        String   @id @default(cuid())
  tenantId  String
  campusId  String
  name      String
  kind      String   // INCOME | EXPENSE
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  campus       Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([campusId, name, kind])
  @@index([tenantId, campusId])
  @@map("finance_categories")
}

model FinancialFund {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions FinanceTransaction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("financial_funds")
}

model FinanceTransaction {
  id               String                 @id @default(cuid())
  tenantId         String
  campusId         String
  accountId        String
  categoryId       String?
  fundId           String?
  type             FinanceTransactionType
  amount           Int                    // cents; always positive
  taxAmount        Int                    @default(0)
  description      String
  reference        String?
  occurredAt       DateTime               @default(now())
  recordedByUserId String
  createdAt        DateTime               @default(now())

  campus   Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  account  FinancialAccount  @relation(fields: [accountId], references: [id])
  category FinanceCategory?  @relation(fields: [categoryId], references: [id])
  fund     FinancialFund?    @relation(fields: [fundId], references: [id])

  @@index([tenantId, campusId, occurredAt])
  @@index([accountId])
  @@index([fundId])
  @@map("finance_transactions")
}

