  createdAt DateTime @default(now())

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@map("route_assignments")
}

enum TripDirection {
  MORNING
  AFTERNOON
  OTHER
}

model TripAttendance {
  id         String        @id @default(cuid())
  tenantId   String
  routeId    String
  tripDate   DateTime
  direction  TripDirection @default(MORNING)
  records    Json          // [{studentId, status: BOARDED | ABSENT | LATE}]
  recordedByUserId String?
  createdAt  DateTime      @default(now())

  route Route @relation(fields: [routeId], references: [id])

  @@index([tenantId])
  @@map("trip_attendances")
}

// ---------------------------------------------------------------------------
// B4. Inventory module
// ---------------------------------------------------------------------------

model InventoryCategory {
  id       String          @id @default(cuid())
  tenantId String
  campusId String
  name     String

  campus Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@index([tenantId])
  @@map("inventory_categories")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  items InventoryItem[]
  pos   PurchaseOrder[]

  @@index([tenantId])
  @@map("suppliers")
}

model Warehouse {
  id       String          @id @default(cuid())
  tenantId String
  campusId String
  name     String

  campus Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@index([tenantId])
  @@map("warehouses")
}

model InventoryItem {
  id               String   @id @default(cuid())
  tenantId         String
  campusId         String
  categoryId       String
  warehouseId      String?
  supplierId       String?
  name             String
  unit             String   @default("pcs")
  reorderThreshold Int      @default(0)
  createdAt        DateTime @default(now())

  campus    Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  category  InventoryCategory @relation(fields: [categoryId], references: [id])
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
  supplier  Supplier?         @relation(fields: [supplierId], references: [id])
  ledger    StockLedgerEntry[]
  requisitionLines RequisitionLine[]
  poLines   PurchaseOrderLine[]
  assignments AssetAssignment[]

  @@index([tenantId])
  @@map("inventory_items")
}

// Append-only stock ledger — current quantity = SUM(qty)
model StockLedgerEntry {
  id        String   @id @default(cuid())
  tenantId  String
  itemId    String
  qty       Int      // positive = in, negative = out
  reason    String   // PURCHASE | REQUISITION | ADJUSTMENT | RETURN
  reference String?
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([itemId])
  @@map("stock_ledger_entries")
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  FULFILLED
}

model Requisition {
  id          String            @id @default(cuid())
  tenantId    String
  campusId    String
  requestedByUserId String
  status      RequisitionStatus @default(DRAFT)
  approvalRequestId String?
  notes       String?
  createdAt   DateTime          @default(now())

  campus Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  lines  RequisitionLine[]

  @@index([tenantId])
  @@map("requisitions")
}

model RequisitionLine {
  id            String   @id @default(cuid())
  tenantId      String
  requisitionId String
  itemId        String
  qty           Int

  requisition Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@index([tenantId])
  @@map("requisition_lines")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  tenantId    String
  campusId    String
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  totalAmount Int                 @default(0)
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())

  campus   Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id      String   @id @default(cuid())
  tenantId String
  poId    String
  itemId  String
  qty     Int
  unitCost Int     @default(0) // cents

  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([tenantId])
  @@map("purchase_order_lines")
}

model AssetAssignment {
  id         String    @id @default(cuid())
  tenantId   String
  itemId     String
  assignedToUserId String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?

  item       InventoryItem @relation(fields: [itemId], references: [id])
  assignedTo User          @relation(fields: [assignedToUserId], references: [id])

  @@index([tenantId])
  @@map("asset_assignments")
}

// ---------------------------------------------------------------------------
// B5. Health & Safeguarding module
// IMPORTANT: These permissions MUST NOT be added to campusAdminRole or any
// default role in seed.ts — access is deliberately narrow (dedicated role only).
// ---------------------------------------------------------------------------

model HealthRecord {
  id        String   @id @default(cuid())
  tenantId  String
  campusId  String
  studentId String   @unique
  // General health notes — diet restrictions, known conditions, emergency contacts
  allergies String?
  conditions String?
  emergencyContact String?
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  campus  Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  incidents HealthIncident[]

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@map("health_records")
}

model HealthIncident {
  id             String   @id @default(cuid())
  tenantId       String
  campusId       String
  healthRecordId String
  description    String
  reportedByUserId String
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  campus       Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  healthRecord HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("health_incidents")
}

enum SafeguardingCaseStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

model SafeguardingCase {
  id        String                 @id @default(cuid())
  tenantId  String
  campusId  String
  studentId String
  title     String
  status    SafeguardingCaseStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime               @default(now())

  campus  Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  student Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  notes   SafeguardingNote[]

  @@index([tenantId])
  @@index([studentId])
  @@map("safeguarding_cases")
}

// Append-only audit trail — notes are never deleted or updated.
model SafeguardingNote {
  id          String   @id @default(cuid())
  tenantId    String
  caseId      String
  authorUserId String
  body        String
  createdAt   DateTime @default(now())

  case SafeguardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("safeguarding_notes")
}

// ---------------------------------------------------------------------------
// Payment gateway inbound webhooks (FEE-003/005)
// Provider-neutral: a tenant holds one signing secret per provider; each
// inbound event is logged once (unique provider+eventId) so retries are no-ops.
// ---------------------------------------------------------------------------

model PaymentGatewayConfig {
  id            String   @id @default(cuid())
  tenantId      String
  provider      String   @default("generic")
  webhookSecret String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, provider])
  @@map("payment_gateway_configs")
}

model GatewayWebhookEvent {
  id         String   @id @default(cuid())
  tenantId   String
  provider   String
  eventId    String
  type       String
  status     String // PROCESSED | IGNORED | FAILED
  paymentId  String?
  error      String?
  payload    Json
  receivedAt DateTime @default(now())

  @@unique([tenantId, provider, eventId])
  @@index([tenantId, receivedAt])
  @@map("gateway_webhook_events")
}
