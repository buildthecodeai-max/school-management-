// ---------------------------------------------------------------------------
// Leave management (ATT-005) — reused by HR module
// ---------------------------------------------------------------------------

model LeaveType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  daysPerYear Float    @default(0)
  isPaid      Boolean  @default(true)
  // STAFF | STUDENT | BOTH
  appliesTo   String   @default("STAFF")
  createdAt   DateTime @default(now())

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("leave_types")
}

model LeaveBalance {
  id             String   @id @default(cuid())
  tenantId       String
  leaveTypeId    String
  personId       String
  academicYearId String?  // null = calendar-year balance
  totalDays      Float    @default(0)
  usedDays       Float    @default(0)
  updatedAt      DateTime @updatedAt

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([leaveTypeId, personId, academicYearId])
  @@index([tenantId])
  @@index([personId])
  @@map("leave_balances")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id               String             @id @default(cuid())
  tenantId         String
  campusId         String
  personId         String             // may be Staff or Student
  leaveTypeId      String
  staffId          String?            // set when the requester is a staff member
  startDate        DateTime
  endDate          DateTime
  days             Float
  reason           String?
  status           LeaveRequestStatus @default(PENDING)
  reviewedByUserId String?
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  staff     Staff?    @relation(fields: [staffId], references: [id])

  @@index([tenantId])
  @@index([personId])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Timetable (ACD-001/002/003) — rooms, slots, versioned schedules
// ---------------------------------------------------------------------------

model Room {
  id        String   @id @default(cuid())
  tenantId  String
  campusId  String
  code      String
  name      String
  capacity  Int      @default(30)
  roomType  String   @default("CLASSROOM")
  createdAt DateTime @default(now())

  campus         Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]

  @@unique([campusId, code])
  @@index([tenantId])
  @@map("rooms")
}

enum TimetableVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Mirrors the ResultVersion snapshot pattern — one active version per campus
// per academic year; publishing a new one archives the previous (ACD-003).
model TimetableVersion {
  id               String                 @id @default(cuid())
  tenantId         String
  campusId         String
  academicYearId   String
  termId           String?
  name             String
  status           TimetableVersionStatus @default(DRAFT)
  publishedByUserId String?
  publishedAt      DateTime?
  createdAt        DateTime               @default(now())

  campus Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  slots  TimetableSlot[]

  @@index([tenantId])
  @@index([campusId])
  @@map("timetable_versions")
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model TimetableSlot {
  id           String    @id @default(cuid())
  tenantId     String
  versionId    String
  sectionId    String
  subjectId    String
  staffId      String?
  roomId       String?
  dayOfWeek    DayOfWeek
  periodNumber Int       // 1-based within the day
  startTime    String    // "HH:MM" local to campus timezone
  endTime      String    // "HH:MM"
  createdAt    DateTime  @default(now())

  version TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject          @relation(fields: [subjectId], references: [id])
  staff   Staff?           @relation(fields: [staffId], references: [id])
  room    Room?            @relation(fields: [roomId], references: [id])
  substituteAssignments SubstituteAssignment[]

  @@unique([versionId, sectionId, dayOfWeek, periodNumber])
  @@index([tenantId])
  @@index([versionId])
  @@map("timetable_slots")
}

// ---------------------------------------------------------------------------
// Approval workflow (IAM-003) — generic maker-checker
// Piloted on fee.adjust (credit notes / refunds) and admissions.decide.
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  tenantId          String
  campusId          String?
  // Identifies what kind of action needs approval — e.g. "fee.adjust",
  // "admissions.decide". Used by resolvers to dispatch to the right handler.
  requestType       String
  referenceType     String?        // entity type, e.g. "CreditNote"
  referenceId       String?        // entity id the approval is for
  requestedByUserId String
  assignedToUserId  String?
  status            ApprovalStatus @default(PENDING)
  payload           Json           // snapshot of the request details
  note              String?        // requester's note
  decisionNote      String?        // approver's note
  decidedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([tenantId])
  @@index([requestedByUserId])
  @@index([assignedToUserId])
  @@index([status])
  @@map("approval_requests")
}

